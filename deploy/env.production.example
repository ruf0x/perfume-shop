# Production .env for the Laravel API (Roze Sham, cPanel account <compte-cpanel>).
# Create it on the server as  /home/<compte-cpanel>/laravel/.env  and replace every <...> value.

APP_NAME="Roze Sham"
APP_ENV=production
APP_KEY=                      # filled by: php artisan key:generate --force
APP_DEBUG=false               # NEVER true in production: errors would show paths and secrets
APP_URL=https://api.votre-domaine.com
FRONTEND_URL=https://votre-domaine.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Algiers

LOG_CHANNEL=stack
LOG_STACK=daily               # one log file per day
LOG_LEVEL=warning

# Database: create it in cPanel > Bases de données MySQL (names get the prefix <compte-cpanel>_)
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<compte>_roze
DB_USERNAME=<compte>_roze
DB_PASSWORD=<password you gave this database user in cPanel>
DB_TIMEZONE=+01:00

# Login session: one cookie shared by votre-domaine.com and api.votre-domaine.com (note the leading dot)
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_DOMAIN=.votre-domaine.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=votre-domaine.com,www.votre-domaine.com
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

CACHE_STORE=database
QUEUE_CONNECTION=sync         # no background worker on shared hosting
MAIL_MAILER=log
DEV_API_TOKENS=false          # the Postman/Swagger token login must stay OFF in production

# First admin account, read ONCE by the seeder (php artisan db:seed --force).
# Then DELETE the ADMIN_PASSWORD line from this file (DEPLOY.md, step 8).
ADMIN_NAME="Propriétaire"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<a long password only you know, different from your local one>

# Weekly database backup (Sunday 03:00): keep this folder OUTSIDE public_html
BACKUP_PATH=/home/<compte-cpanel>/backups
DB_DUMP_BINARY=mysqldump

# Which starting product types the seeder creates (this shop sells perfumes and cosmetics)
SHOP_TYPES=parfums,cosmetiques
