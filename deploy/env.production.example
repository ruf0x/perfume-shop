# Production .env for the Laravel API. Copy to  ~/laravel/.env  on the server and fill in the <...> values.
# Replace monshop.dz everywhere with your real domain, and CPUSER with your cPanel username.

APP_NAME="Perfume Shop"
APP_ENV=production
APP_KEY=                      # filled by: php artisan key:generate
APP_DEBUG=false               # NEVER true in production: it would show passwords and paths in errors
APP_URL=https://api.monshop.dz
FRONTEND_URL=https://monshop.dz
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Algiers

LOG_CHANNEL=stack
LOG_STACK=daily               # one log file per day, old ones are removed
LOG_LEVEL=warning

# Database: create it in cPanel > Bases de données MySQL (the names get your cPanel prefix)
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPUSER_perfume
DB_USERNAME=CPUSER_perfume
DB_PASSWORD=<strong password from cPanel>
DB_TIMEZONE=+01:00

# Login session (cookie shared by monshop.dz and api.monshop.dz, so note the leading dot)
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
SESSION_DOMAIN=.monshop.dz
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=monshop.dz,www.monshop.dz
CORS_ALLOWED_ORIGINS=https://monshop.dz,https://www.monshop.dz

CACHE_STORE=database
QUEUE_CONNECTION=sync         # no background worker on shared hosting
MAIL_MAILER=log
DEV_API_TOKENS=false          # the Postman/Swagger token login must stay OFF in production

# First admin account, used ONCE by the seeder (php artisan db:seed --force).
# Then DELETE the ADMIN_PASSWORD line (see DEPLOY.md, step 7).
ADMIN_NAME="Propriétaire"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<a long password only you know>

# Weekly database backup: keep this folder OUTSIDE public_html
BACKUP_PATH=/home/CPUSER/backups
DB_DUMP_BINARY=mysqldump
